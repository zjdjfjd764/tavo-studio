# multimodal_tool configuration template (ASCII only).
# install.ps1 copies this file to .env (same directory as the script) and asks
# for the three API keys. You can also edit .env yourself. Everything except
# the API keys has built-in defaults inside the script, so only these three
# are required:
#   ARK_API_KEY            Doubao / Volcengine ARK vision key
#   VOLINK_IMAGE_API_KEY   Volink image generation key
#   VOLINK_TTS_API_KEY     Volink text-to-speech key
# Optional overrides (leave empty to use built-in defaults):
#   ARK_BASE_URL           default: https://ark.cn-beijing.volces.com/api/v3
#   ARK_VISION_MODEL       default: doubao-seed-1-6-250615
#   VOLINK_BASE_URL        default: https://api.volink.org/v1
#   VOLINK_IMAGE_MODEL     default: gpt-image-2-by-openai
#   VOLINK_TTS_MODEL       default: minimax/speech-02-turbo
#   VOLINK_TTS_VOICE       default: 693cf29a05b2018407fd1989
#   VOLINK_TTS_FORMAT      default: mp3
ARK_API_KEY=
ARK_BASE_URL=
ARK_VISION_MODEL=
VOLINK_BASE_URL=
VOLINK_IMAGE_API_KEY=
VOLINK_IMAGE_MODEL=
VOLINK_TTS_API_KEY=
VOLINK_TTS_MODEL=
VOLINK_TTS_VOICE=
VOLINK_TTS_FORMAT=
